# Database Configuration
# For PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/stock_screener

# For local testing with SQLite (no installation required)
# DATABASE_URL=sqlite:///./stock_screener.db

# Logging Configuration
LOG_LEVEL=INFO

# Cache Configuration
CACHE_DIR=./data/cache
CACHE_EXPIRY_HOURS=24

# Email Notification Configuration
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_TO=recipient@example.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Slack Notification Configuration (optional)
# Option 1: Webhook URL (easier setup)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Option 2: Bot Token (more features)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#stock-alerts

# Screening Configuration
SCREENING_TICKERS=AAPL,MSFT,GOOGL,AMZN,META,JPM,BAC,WMT,JNJ,XOM
SCREENING_TOP_N=10
SCREENING_MIN_SIGNAL=50

# Fidelity position tracking (optional) - no credentials needed here.
# Export your positions from Fidelity's website (Accounts & Trade -> Positions
# -> Download) and pass the CSV directly: python manage_positions.py --csv <file>

# Reddit Integration (optional - read-only ticker mention tracking)
# Create a free "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your-app-client-id
# REDDIT_CLIENT_SECRET=your-app-client-secret
# REDDIT_USER_AGENT=stock-screener-bot/1.0 (read-only)

# Anthropic API (optional - powers the Fundamentals Auditor and Catalyst Sentiment
# agents; get a key at https://console.anthropic.com -> API Keys). Without this set,
# run_optimized_scan.py --enable-llm-agents no-ops with a logged warning.
# ANTHROPIC_API_KEY=sk-ant-...
